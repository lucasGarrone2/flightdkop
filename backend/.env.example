# Environment variables example for Argentina -> Denmark Finder

# Port
PORT=3000

# Flight Provider API (SerpApi - Google Flights)
SERPAPI_KEY=your_serpapi_key_here

# Database URL (PostgreSQL via Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/flightdb?schema=public"

# Telegram Bot (For future Stage 11)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
